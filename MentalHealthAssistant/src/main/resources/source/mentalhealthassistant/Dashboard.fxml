                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>
                        <Button alignment="BOTTOM_LEFT" mnemonicParsing="false" onAction="#toggleCopingMechanism" prefHeight="38.0" prefWidth="179.0" style="-fx-background-color: #00008B;" text="Coping Mechanism" textFill="WHITE">
