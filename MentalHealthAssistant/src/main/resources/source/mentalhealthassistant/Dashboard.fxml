            </font>
        </Text>
        <Text fill="#0000fff2" layoutX="422.0" layoutY="168.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome" wrappingWidth="92.0">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Text>

