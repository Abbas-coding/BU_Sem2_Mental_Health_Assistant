                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </MenuButton>
                        <Button alignment="BOTTOM_LEFT" mnemonicParsing="false" onAction="#toggleMoodLog" prefHeight="38.0" prefWidth="179.0" style="-fx-background-color: #00008B;" text="Mood Log" textFill="WHITE">
