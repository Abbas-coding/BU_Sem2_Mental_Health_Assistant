                            </font>
                        </Button>
                        <Button alignment="BOTTOM_LEFT" mnemonicParsing="false" onAction="#handleLogout" prefHeight="38.0" prefWidth="179.0" style="-fx-background-color: #00008B;" text="Logout" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </AnchorPane>
        <ImageView fitHeight="156.0" fitWidth="228.0" layoutX="338.0" layoutY="174.0" pickOnBounds="true" preserveRatio="true">
