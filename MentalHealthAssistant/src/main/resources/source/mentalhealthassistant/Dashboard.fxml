                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>
                        <MenuButton alignment="BOTTOM_LEFT" mnemonicParsing="false" prefHeight="45.0" prefWidth="184.0" style="-fx-background-color: #00008B;" text="Reminders" textFill="WHITE">
