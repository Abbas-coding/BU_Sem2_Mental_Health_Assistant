<AnchorPane prefHeight="550.0" prefWidth="730.0" style="-fx-background-color: #e6f2ff;" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="source.mentalhealthassistant.DashboardController">
    <children>
        <AnchorPane layoutX="-6.0" layoutY="-2.0" prefHeight="46.0" prefWidth="200.0" style="-fx-background-color: #00008B;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <children>
                <ImageView fx:id="exit" fitHeight="24.0" fitWidth="24.0" layoutX="759.0" layoutY="15.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/cross.png" />
                    </image>
                </ImageView>
                <ImageView fx:id="drawerImage" fitHeight="32.0" fitWidth="32.0" layoutX="14.0" layoutY="7.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@images/stack.png" />
                    </image>
                </ImageView>
            </children>
        </AnchorPane>
        <AnchorPane fx:id="drawerPane" layoutY="46.0" prefHeight="387.0" prefWidth="47.0" style="-fx-background-color: #e6f2ff;" AnchorPane.bottomAnchor="-1.0" AnchorPane.leftAnchor="0.0">
            <children>
                <VBox alignment="TOP_CENTER" layoutX="2.0" layoutY="95.0" prefHeight="336.0" prefWidth="45.0" spacing="25.0" AnchorPane.topAnchor="95.0">
                    <children>
                        <ImageView fitHeight="46.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/chat.png" />
                            </image>
                        </ImageView>
                        <ImageView fitHeight="46.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/alarm.png" />
                            </image>
                        </ImageView>
                        <ImageView fitHeight="46.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/mood.png" />
                            </image>
                        </ImageView>
                        <ImageView fitHeight="46.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/coping.png" />
                            </image>
                        </ImageView>
                        <ImageView fitHeight="46.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@images/logout.png" />
                            </image>
                        </ImageView>
                    </children>
                </VBox>
                  <ImageView fitHeight="46.0" fitWidth="32.0" layoutX="8.0" layoutY="33.0" pickOnBounds="true" preserveRatio="true">
                      <image>
                          <Image url="@images/home.png" />
                      </image>
                  </ImageView>
            </children>
        </AnchorPane>
        <AnchorPane fx:id="opacityPane" layoutX="46.0" layoutY="45.0" prefHeight="454.0" prefWidth="179.0" AnchorPane.bottomAnchor="0.0" AnchorPane.topAnchor="46.0">
            <children>
                <VBox prefHeight="200.0" prefWidth="100.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="20.0">
                    <children>
                        <Button alignment="BOTTOM_LEFT" mnemonicParsing="false" onAction="#handleDashboard" prefHeight="38.0" prefWidth="179.0" style="-fx-background-color: #00008B;" text="Dashboard" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Button>
                        <Button alignment="BOTTOM_LEFT" layoutX="100.0" layoutY="200.0" mnemonicParsing="false" onAction="#toggleChatbot" prefHeight="38.0" prefWidth="179.0" style="-fx-background-color: #00008B;" text="Chat with Chatbot" textFill="WHITE">
