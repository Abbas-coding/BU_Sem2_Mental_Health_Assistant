      <Label layoutX="72.0" layoutY="243.0" text="Password">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="346.0" layoutY="103.0" text="Username">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="348.0" layoutY="243.0" text="Confirm Password">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="68.0" layoutY="172.0" text="Email">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="351.0" layoutY="168.0" text="Age">
         <font>
            <Font name="System Bold" size="12.0" />
