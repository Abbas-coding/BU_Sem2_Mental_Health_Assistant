<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="taskReminderContainer" prefHeight="390.0" prefWidth="579.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="source.mentalhealthassistant.TaskReminderController">
   <children>
      <Pane layoutX="-6.0" prefHeight="419.0" prefWidth="589.0" style="-fx-background-color: linear-gradient(to bottom, #A1C6EA, #F5F5DC, #D0E8F7);">
         <children>
            <ImageView fitHeight="370.0" fitWidth="371.0" layoutX="86.0" layoutY="6.0" opacity="0.38" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/bell.png" />
               </image>
            </ImageView>
            <Label layoutX="209.0" layoutY="22.0" prefHeight="35.0" prefWidth="162.0" text="REMINDERS" textFill="#004d80">
               <font>
                  <Font name="Arial Black" size="23.0" />
               </font>
            </Label>
            <Label layoutX="247.0" layoutY="58.0" prefHeight="25.0" prefWidth="53.0" text="TASK" textFill="#004d80">
               <font>
                  <Font name="System Bold" size="19.0" />
               </font>
            </Label>
            <Label layoutX="143.0" layoutY="105.0" prefHeight="21.0" prefWidth="142.0" text="Describe Your Task">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            <TextField fx:id="taskDescriptionField" layoutX="143.0" layoutY="128.0" prefHeight="30.0" prefWidth="262.0" promptText="Enter a Task">
               <effect>
                  <DropShadow />
               </effect>
            </TextField>
            <Label layoutX="147.0" layoutY="166.0" prefHeight="17.0" prefWidth="40.0" text="Date">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            <TextField fx:id="dateField" layoutX="143.0" layoutY="189.0" prefHeight="30.0" prefWidth="262.0" promptText="YYYY-MM-DD">
               <effect>
                  <DropShadow />
               </effect>
            </TextField>
            <RadioButton fx:id="repeatWeeklyRadioButton" layoutX="137.0" layoutY="303.0" mnemonicParsing="false" text="Repeat Weekly">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </RadioButton>
            <Button layoutX="214.0" layoutY="336.0" mnemonicParsing="false" onAction="#handleSetReminder" prefHeight="25.0" prefWidth="120.0" style="-fx-background-color: #004d80;" text="Set Reminder" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
            <RadioButton fx:id="repeatDailyRadioButton" layoutX="300.0" layoutY="303.0" mnemonicParsing="false" text="Repeat Daily">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </RadioButton>
            <TextField fx:id="timeField" layoutX="143.0" layoutY="240.0" prefHeight="30.0" prefWidth="262.0" promptText="HH:MM">
               <effect>
                  <DropShadow />
               </effect>
            </TextField>
            <Label layoutX="143.0" layoutY="219.0" prefHeight="17.0" prefWidth="47.0" text="Time">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
         </children>
      </Pane>
   </children>
</AnchorPane>
