<!--                    <TableColumn fx:id="logColumnMood" prefWidth="112.0" style="-fx-background-color: #e6e6ff;" text="Mood" />-->
<!--                    <TableColumn fx:id="logColumnTimestamp" prefWidth="177.0" style="-fx-background-color: #e6e6ff;" text="Timestamp" />-->
<!--                </columns>-->
