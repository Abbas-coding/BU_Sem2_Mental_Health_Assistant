<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: linear-gradient(    from 0% 100% to 0% 0%,     #002e4d 0%,  /* Dark blue at the bottom */    #004d80 30%, /* Lighter blue for a smooth transition */    #66a3cc 60%, /* Light blue for further blending */    #ffffff 100%  /* Solid white at the top */);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="source.mentalhealthassistant.RecoverPasswordController">
   <children>
      <Label layoutX="226.0" layoutY="29.0" prefHeight="32.0" prefWidth="175.0" text=" Password Reset" textFill="#0000cf">
         <font>
            <Font name="System Bold" size="22.0" />
         </font></Label>
      <Label layoutX="238.0" layoutY="92.0" text="Email" textFill="#fcfafa">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="237.0" layoutY="173.0" text="Set New Password" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="238.0" layoutY="253.0" text="Confirm Password" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Button layoutX="257.0" layoutY="321.0" mnemonicParsing="false" onAction="#handleRecoverPassword" prefHeight="27.0" prefWidth="112.0" text="Recover" textFill="#068606">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Button>
      <TextField fx:id="emailField" layoutX="238.0" layoutY="114.0">
         <effect>
            <DropShadow />
         </effect></TextField>
      <PasswordField fx:id="newPasswordField" layoutX="238.0" layoutY="193.0">
         <effect>
            <DropShadow />
         </effect></PasswordField>
      <PasswordField fx:id="confirmPasswordField" layoutX="239.0" layoutY="273.0">
         <effect>
            <DropShadow />
         </effect></PasswordField>
      <Button layoutX="257.0" layoutY="359.0" mnemonicParsing="false" onAction="#backToLogin" prefHeight="32.0" prefWidth="112.0" text="Back To Login" textFill="#080099">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
