<AnchorPane prefHeight="470.0" prefWidth="734.0" style="-fx-background-color: linear-gradient(    from 0% 100% to 0% 0%,     #002e4d 0%,  /* Dark blue at the bottom */    #004d80 30%, /* Lighter blue for a smooth transition */    #66a3cc 60%, /* Light blue for further blending */    #ffffff 100%  /* Solid white at the top */);" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="source.mentalhealthassistant.RecoverPasswordController">
   <children>
      <Label layoutX="280.0" layoutY="27.0" prefHeight="32.0" prefWidth="175.0" text=" Password Reset" textFill="#0000cf">
         <font>
            <Font name="System Bold" size="22.0" />
         </font></Label>
      <Label layoutX="263.0" layoutY="89.0" text="Email" textFill="#fcfafa">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="262.0" layoutY="168.0" text="Set New Password" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Label layoutX="263.0" layoutY="244.0" text="Confirm Password" textFill="WHITE">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Label>
      <Button layoutX="254.0" layoutY="345.0" mnemonicParsing="false" onAction="#handleRecoverPassword" prefHeight="27.0" prefWidth="112.0" text="Recover" textFill="#068606">
