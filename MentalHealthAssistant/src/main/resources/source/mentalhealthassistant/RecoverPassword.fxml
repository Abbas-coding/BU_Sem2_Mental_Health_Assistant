<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: linear-gradient(to bottom, #A1C6EA, #F5F5DC, #D0E8F7);" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="source.mentalhealthassistant.RecoverPasswordController">
   <children>
      <Label layoutX="226.0" layoutY="29.0" prefHeight="32.0" prefWidth="175.0" text=" Password Reset" textFill="DARKBLUE">
