<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="375.0" prefWidth="421.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="source.mentalhealthassistant.EventReminderController">
   <children>
      <Pane prefHeight="428.0" prefWidth="581.0" style="-fx-background-color: linear-gradient(to bottom, #A1C6EA, #F5F5DC, #D0E8F7);">
         <children>
            <ImageView fitHeight="428.0" fitWidth="393.0" layoutX="94.0" opacity="0.28" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@images/bell.png" />
               </image>
            </ImageView>
            <Label layoutX="220.0" layoutY="11.0" prefHeight="30.0" prefWidth="142.0" text="REMINDERS" textFill="#0b0b97">
               <font>
                  <Font name="Arial Black" size="21.0" />
               </font>
            </Label>
            <Label layoutX="255.0" layoutY="53.0" prefHeight="31.0" prefWidth="73.0" text="EVENT" textFill="#351e80">
               <font>
                  <Font name="System Bold" size="21.0" />
               </font>
            </Label>
            <Label layoutX="160.0" layoutY="151.0" prefHeight="27.0" prefWidth="57.0" text="Title">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            <TextField fx:id="titleTextField" layoutX="160.0" layoutY="178.0" prefHeight="30.0" prefWidth="262.0" promptText="Enter  Task">
               <effect>
                  <DropShadow />
               </effect>
            </TextField>
            <Label layoutX="161.0" layoutY="239.0" prefHeight="17.0" prefWidth="40.0" text="Date">
               <font>
                  <Font name="Arial Black" size="15.0" />
               </font>
            </Label>
            <TextField fx:id="dateTextField" layoutX="161.0" layoutY="268.0" prefHeight="30.0" prefWidth="262.0" promptText=" YYYY-MM-DD  (HH:MM)">
               <effect>
                  <DropShadow />
               </effect>
            </TextField>
            <Button fx:id="setReminderButton" layoutX="231.0" layoutY="324.0" mnemonicParsing="false" onAction="#handleSetReminder" prefHeight="25.0" prefWidth="120.0" style="-fx-background-color: #004d80;" text="Set Reminder" textFill="WHITE">
               <effect>
                  <DropShadow />
               </effect>
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
         </children>
      </Pane>
   </children>
</AnchorPane>
