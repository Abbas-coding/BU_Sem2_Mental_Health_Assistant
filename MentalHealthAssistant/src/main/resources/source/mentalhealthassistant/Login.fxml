<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="source.mentalhealthassistant.LoginController">
   <children>
      <Label layoutX="353.0" layoutY="103.0" prefHeight="12.0" prefWidth="86.0" text="Username" />
      <PasswordField fx:id="passwordField" layoutX="353.0" layoutY="216.0" prefHeight="26.0" prefWidth="162.0" />
      <TextField fx:id="usernameField" layoutX="353.0" layoutY="129.0" prefHeight="26.0" prefWidth="162.0" />
      <Label layoutX="353.0" layoutY="192.0" prefHeight="12.0" prefWidth="86.0" text="Password" />
      <Hyperlink fx:id="forgetPasswordHyperlink" layoutX="477.0" layoutY="263.0" text="Forgot Password?" onAction="#goToForgetPassword" />
      <Button layoutX="405.0" layoutY="307.0" mnemonicParsing="false" text="Login"  onAction="#handleLogin"/>
      <Hyperlink fx:id="signupHyperlink" layoutX="345.0" layoutY="350.0" onAction="#goToSignup" text="Create an Account? Signup" />
      <Label layoutX="39.0" layoutY="137.0" prefHeight="97.0" prefWidth="231.0" text="Welcome to Mental Health Assistant" />
      <Label layoutX="428.0" layoutY="26.0" prefHeight="38.0" prefWidth="46.0" text="LOGIN" />
   </children>
</AnchorPane>
