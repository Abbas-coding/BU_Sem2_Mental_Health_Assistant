<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="328.0" prefWidth="585.0" style="-fx-background-color: #131227;" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="source.mentalhealthassistant.LoginController">
   <children>
      <ImageView fitHeight="419.0" fitWidth="603.0" layoutX="-1.0" layoutY="-2.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/loginBG.png" />
         </image>
      </ImageView>
      <Label fx:id="welcomeText" layoutX="349.0" layoutY="88.0" prefHeight="18.0" prefWidth="230.0" textFill="#ff1e1e">
         <font>
            <Font name="System Italic" size="12.0" />
         </font></Label>

      <Label layoutX="334.0" layoutY="112.0" prefHeight="12.0" prefWidth="86.0" text="Username" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <PasswordField fx:id="passwordField" layoutX="336.0" layoutY="194.0" prefHeight="26.0" prefWidth="178.0">
         <effect>
            <DropShadow />
         </effect></PasswordField>
      <TextField fx:id="usernameField" layoutX="334.0" layoutY="133.0" prefHeight="26.0" prefWidth="184.0">
         <effect>
            <DropShadow />
         </effect></TextField>
      <Label layoutX="331.0" layoutY="172.0" prefHeight="12.0" prefWidth="86.0" text="Password" textFill="#fcf7f7">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <Hyperlink fx:id="forgetPasswordHyperlink" layoutX="483.0" layoutY="232.0" onAction="#goToForgetPassword" text="Forgot Password?" textFill="#8e0000">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Hyperlink>
      <Button layoutX="428.0" layoutY="269.0" mnemonicParsing="false" onAction="#handleLogin" prefHeight="31.0" prefWidth="75.0" style="-fx-background-color: #004d80;" text="Login" textFill="WHITE">
         <font>
            <Font name="Calibri Bold" size="13.0" />
         </font></Button>
      <Hyperlink fx:id="signupHyperlink" layoutX="384.0" layoutY="310.0" onAction="#goToSignup" text="Create an Account? Signup" textFill="#015b01">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Hyperlink>
      <Label fx:id="loginHeading" layoutX="436.0" layoutY="49.0" prefHeight="38.0" prefWidth="62.0" text="LOGIN" textFill="#f7f0f0">
         <font>
            <Font name="Lucida Fax Regular" size="18.0" />
         </font>
      </Label>
      <Label fx:id="loginHeading1" layoutX="135.0" layoutY="1.0" prefHeight="39.0" prefWidth="366.0" text="Mental  Health  Assistant" textFill="#f7f0f0">
         <font>
            <Font name="Lucida Handwriting Italic" size="24.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
