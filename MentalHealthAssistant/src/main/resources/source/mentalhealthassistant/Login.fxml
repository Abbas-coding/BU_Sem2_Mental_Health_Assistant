<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="466.0" prefWidth="790.0" style="-fx-background-color: #131227;" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="source.mentalhealthassistant.LoginController">
   <children>
      <ImageView fitHeight="474.0" fitWidth="792.0" layoutX="-1.0" layoutY="-1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@images/loginBG.png" />
         </image>
      </ImageView>
      <Label fx:id="welcomeText" layoutX="349.0" layoutY="88.0" prefHeight="18.0" prefWidth="230.0" textFill="#ff1e1e">
         <font>
            <Font name="System Italic" size="12.0" />
         </font></Label>

      <Label layoutX="465.0" layoutY="159.0" prefHeight="12.0" prefWidth="93.0" text="Username" textFill="WHITE">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <PasswordField fx:id="passwordField" layoutX="468.0" layoutY="248.0" prefHeight="26.0" prefWidth="178.0">
         <effect>
            <DropShadow />
         </effect></PasswordField>
      <TextField fx:id="usernameField" layoutX="465.0" layoutY="185.0" prefHeight="26.0" prefWidth="184.0">
         <effect>
            <DropShadow />
         </effect></TextField>
      <Label layoutX="468.0" layoutY="224.0" prefHeight="12.0" prefWidth="86.0" text="Password" textFill="#fcf7f7">
         <font>
            <Font name="System Bold" size="13.0" />
         </font></Label>
      <Hyperlink fx:id="forgetPasswordHyperlink" layoutX="563.0" layoutY="285.0" onAction="#goToForgetPassword" text="Forgot Password?" textFill="#8e0000">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Hyperlink>
      <Button layoutX="542.0" layoutY="335.0" mnemonicParsing="false" onAction="#handleLogin" prefHeight="31.0" prefWidth="75.0" style="-fx-background-color: #004d80;" text="Login" textFill="WHITE">
         <font>
            <Font name="Calibri Bold" size="13.0" />
         </font></Button>
      <Hyperlink fx:id="signupHyperlink" layoutX="499.0" layoutY="375.0" onAction="#goToSignup" text="Create an Account? Signup" textFill="#015b01">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Hyperlink>
      <Label fx:id="loginHeading" layoutX="548.0" layoutY="87.0" prefHeight="38.0" prefWidth="62.0" text="LOGIN" textFill="#f7f0f0">
         <font>
            <Font name="Lucida Fax Regular" size="18.0" />
         </font>
      </Label>
      <Label fx:id="loginHeading1" layoutX="245.0" layoutY="20.0" prefHeight="39.0" prefWidth="366.0" text="Mental  Health  Assistant" textFill="#f7f0f0">
         <font>
            <Font name="Lucida Handwriting Italic" size="24.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
